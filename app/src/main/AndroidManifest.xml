<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.spotify.musia" />
        <package android:name="com.spotify.musib" />
        <package android:name="com.waze" />
        <package android:name="com.iternio.abrpapp" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_manager"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BYDSpotifyManager">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />


    </application>
</manifest>
